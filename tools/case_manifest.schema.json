{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaoairphonse/GPU-Accelerated-Multi-Mesh-CFD-for-Neural-Networks/blob/main/tools/case_manifest.schema.json",
  "title": "Quick CFD case manifest v1",
  "description": "Machine-readable handoff generated by tools/cfd_case_builder.html. The native solver configuration or CLI remains authoritative.",
  "type": "object",
  "required": [
    "manifest_schema",
    "schema_version",
    "generator",
    "generated_utc",
    "case",
    "paths",
    "mesh",
    "physics",
    "numerics",
    "initialization",
    "termination",
    "build",
    "run",
    "native_configuration",
    "process",
    "limitations"
  ],
  "properties": {
    "manifest_schema": {"const": "tools/case_manifest.schema.json"},
    "schema_version": {"const": "quick_cfd_case_manifest_v1"},
    "generator": {"const": "tools/cfd_case_builder.html"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "solver_path", "dimension", "entry_point"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "solver_path": {"enum": ["airfoil2d", "amr3d", "unstructured3d"]},
        "dimension": {"enum": [2, 3]},
        "entry_point": {"type": "string", "minLength": 1}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_root", "output_directory"],
      "properties": {
        "repository_root": {"type": "string"},
        "output_directory": {"type": "string", "minLength": 1}
      }
    },
    "mesh": {
      "type": "object",
      "required": ["type", "count_is_target"],
      "properties": {
        "type": {
          "enum": [
            "native_cartesian_quadtree_amr_cut_cell",
            "native_procedural_octree_AMR_cut_cell",
            "external_explicit_face_unstructured"
          ]
        },
        "count_is_target": {"const": false}
      },
      "additionalProperties": true
    },
    "physics": {
      "type": "object",
      "required": ["model", "turbulence", "freestream"],
      "properties": {
        "model": {"type": "string"},
        "turbulence": {"enum": ["none", "sa-neg"]},
        "viscosity": {"type": "string"},
        "freestream": {
          "type": "object",
          "required": ["Mach", "AOA_degrees"],
          "properties": {
            "Mach": {"type": "number", "exclusiveMinimum": 0},
            "AOA_degrees": {"type": "number"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "numerics": {
      "type": "object",
      "required": ["integrator", "implicit", "backend", "spatial_order", "CFL"],
      "properties": {
        "integrator": {"enum": ["rk3", "dplur"]},
        "implicit": {"type": "boolean"},
        "backend": {"enum": ["cpu", "cuda"]},
        "spatial_order": {"enum": [1, 2]},
        "CFL": {"type": "number", "exclusiveMinimum": 0},
        "dplur": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    },
    "initialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "restart_path"],
      "properties": {
        "mode": {"enum": ["uniform", "restart"]},
        "restart_path": {"type": ["string", "null"]}
      }
    },
    "termination": {
      "type": "object",
      "required": ["maximum_iterations", "wall_clock_budget_seconds"],
      "properties": {
        "maximum_iterations": {"type": ["integer", "null"], "minimum": 0},
        "wall_clock_budget_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "commands"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "commands": {"type": "array", "minItems": 2, "items": {"type": "string"}}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "shell_command", "expected_outputs"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "shell_command": {"type": "string", "minLength": 1},
        "expected_outputs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "native_configuration": {"type": ["object", "null"]},
    "process": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "action", "command"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "action": {"type": "string", "minLength": 1},
          "command": {"type": ["string", "null"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
