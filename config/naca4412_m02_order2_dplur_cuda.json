{
  "freestream": {"Mach": 0.2, "AOA_degrees": 1.5, "p_Pa": 101325.0, "T_K": 288.15, "chord_m": 1.0},
  "solver": {
    "backend": "cuda",
    "integrator": "dplur",
    "dplur": {"CFL": 0.5, "sweeps": 5, "omega": 0.8, "block_coupling": true, "maximum_iterations": 200000, "check_interval": 200},
    "spatial_order": 2,
    "preconditioning": "turkel",
    "mach_floor": 0.02,
    "local_pseudo_time": false,
    "adaptive_cfl": {"enabled": false},
    "mode": "steady",
    "budget_seconds": 120.0,
    "stop_time_star": 150.0,
    "convergence": {"metric": "cl_cm_cp", "raw_tolerance": 0.01, "coefficient_change": 0.005, "cp_change": 0.005}
  },
  "output": {"formats": ["npz"]}
}
